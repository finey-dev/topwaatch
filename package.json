{
  "name": "topwaatch",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "workers/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.27",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.23",
      "@trpc/client": "^11.18.0",
      "@better-auth/expo": "1.6.23"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=server --filter=web --filter=@topwaatch/proxy-worker",
    "dev:all": "turbo run dev",
    "dev:desktop": "turbo run dev --filter=desktop --filter=web --filter=server --filter=@topwaatch/proxy-worker",
    "build": "turbo run build",
    "build:desktop": "turbo run build --filter=desktop",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev --filter=server --filter=web --filter=@topwaatch/proxy-worker",
    "dev:native": "turbo run dev -F native",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @topwaatch/db",
    "db:studio": "turbo run db:studio -F @topwaatch/db",
    "db:generate": "turbo run db:generate -F @topwaatch/db",
    "db:migrate": "turbo run db:migrate -F @topwaatch/db"
  },
  "dependencies": {
    "@topwaatch/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@topwaatch/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.2",
    "typescript": "^6"
  },
  "packageManager": "bun@1.3.5"
}
