# Copy to `.env.desktop.local` for local desktop dev (gitignored).
#
# CI release builds: configure the same keys as GitHub Actions secrets
# (Settings → Secrets and variables → Actions → Secrets) — never commit real values.

VITE_NORMAL_ROUTER=false
VITE_DESKTOP_APP=true

VITE_TMDB_READ_API_KEY=
VITE_OPENSEARCH_ENABLED=false

VITE_CORS_PROXY_URL=
VITE_M3U8_PROXY_URL=

VITE_APP_DOMAIN=
VITE_BACKEND_URL=

VITE_FEBBOX_CLIENT_ID=
VITE_FEBBOX_REDIRECT_URI=
VITE_ALLOW_FEBBOX_KEY=true

VITE_DESKTOP_RELEASES_REPO=
VITE_DESKTOP_RELEASE_TAG_PREFIX=desktop-v

VITE_USE_TRAKT=true
VITE_TRAKT_CLIENT_ID=
VITE_TRAKT_CLIENT_SECRET=
VITE_TRAKT_REDIRECT_URI=
