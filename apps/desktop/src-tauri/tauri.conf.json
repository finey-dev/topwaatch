{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopWaatch",
  "version": "0.1.0",
  "identifier": "com.topwaatch.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:web-shell",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build:web-shell",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "TopWaatch",
        "url": "desktop-splash/index.html",
        "width": 420,
        "height": 300,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true,
        "focus": true
      },
      {
        "label": "main",
        "title": "TopWaatch",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https: http: tauri: asset:; connect-src 'self' https: http: ws: wss:; media-src 'self' https: http: blob: data:; img-src 'self' https: http: data: blob:;"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["appimage", "deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/finey-dev/topwaatch/main/apps/desktop/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFRTk5NkE2RTkyNjdGRUIKUldUcmZ5YnBwcGJwenFFSVdmK2NFc2pBNWd2MEhFVTQ0TVZhb2NkdTFjc3o1NjF4eVd4aEp3QnEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
